# NADAPROD — configuration
# Copy this file to `.env` and fill in your values.
# Variables already set in the environment take precedence over this file.

# --- Gemini (required) ---
# API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model. Default: gemini-3.7-flash (alias for the latest stable Flash).
GEMINI_MODEL=gemini-3.7-flash

# Generation parameters (optional). Defaults: 0.7 and 8192.
# GEMINI_TEMPERATURE=0.7
# GEMINI_MAX_TOKENS=8192

# Generations per minute, per account (protects the Gemini quota; a
# "3 variants" click costs three). Default: 30
# GENERATE_RATE_PER_MIN=30

# --- HTTP server ---
# Listen address (host:port). Default: :8080
ADDR=:8080

# --- Imported sites storage ---
# Root directory for sites (one directory = one site). Default: ./sites
SITES_DIR=./sites

# --- Block studio projects ---
# SQLite file (created and migrated at startup; WAL mode adds -wal/-shm
# siblings). Holds every account's projects and block history: back it up.
# Default: ./nadaprod.db
DB_FILE=./nadaprod.db

# --- Stock photos (optional) ---
# With a key, generated blocks get real photos instead of placehold.co
# placeholders, and the studio offers a photo picker. Pexels wins if both are set.
# https://www.pexels.com/api/ · https://unsplash.com/developers
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Tailwind local build ---
# Path to the Tailwind v3 standalone binary (downloaded by bin/build.sh).
# If missing, published sites — and the studio's exports — keep the Play CDN
# (graceful degradation).
# Default: ./bin/tailwindcss
TAILWIND_BIN=./bin/tailwindcss

# --- Local Google Fonts mirror ---
# Directory of TTF families (served on /webfonts; the publish pipeline copies
# the needed fonts into each site). If missing, published sites keep their
# Google Fonts links. Default: ./web/webfonts
WEBFONTS_DIR=./web/webfonts

# --- Accounts (required) ---
# Root account: full access, creates users and assigns sites to them.
ROOT_EMAIL=web@l3dlp.com
# Root password — REQUIRED, the server refuses to start without it.
ROOT_PASSWORD=
# Secret signing the session cookies. Optional: if empty, a random secret is
# generated at startup (all sessions then expire on every restart).
AUTH_SECRET=
# User accounts and waiting-list storage (JSON files, gitignored).
# Defaults: ./users.json and ./waiting-list.json
USERS_FILE=./users.json
WAITLIST_FILE=./waiting-list.json

# --- Gin mode ---
# Leave empty for release mode. Set to "debug" for verbose logs.
GIN_MODE=
