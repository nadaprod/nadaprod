# Windpage Studio — configuration
# Copiez ce fichier en `.env` et renseignez vos valeurs.
# Les variables déjà définies dans l'environnement ont la priorité sur ce fichier.

# --- Gemini (obligatoire) ---
# Clé API : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèle. Défaut : gemini-flash-latest (alias du dernier Flash stable).
GEMINI_MODEL=gemini-flash-latest

# --- Serveur HTTP ---
# Adresse d'écoute (host:port). Défaut : :8080
ADDR=:8080

# --- Stockage des sites importés ---
# Dossier racine des sites (un dossier = un site). Défaut : ./sites
SITES_DIR=./sites

# --- Mode gin ---
# Laisser vide pour le mode release. Mettre "debug" pour les logs détaillés.
GIN_MODE=
